# =============================================================================
# FICHIER MODÈLE DES VARIABLES D'ENVIRONNEMENT
# -----------------------------------------------------------------------------
# Ce fichier est versionné dans Git (il ne contient AUCUN vrai secret).
# Copie-le en ".env" puis remplis les vraies valeurs :
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
# Le fichier ".env" réel, lui, est ignoré par Git (voir .gitignore).
# =============================================================================

# --- OpenSky Network (données de vols) ---
# Inscription gratuite : https://opensky-network.org/
OPENSKY_USERNAME=ton_identifiant_opensky
OPENSKY_PASSWORD=ton_mot_de_passe_opensky

# --- OpenWeather (données météo) ---
# Clé API gratuite : https://openweathermap.org/api
OPENWEATHER_API_KEY=ta_cle_api_openweather

# --- NewsAPI (actualités) ---
# Clé API gratuite : https://newsapi.org/
NEWSAPI_KEY=ta_cle_api_newsapi

# --- Base de données ---
# Connexion à l'instance PostgreSQL (locale via Docker, ou serveur distant) :
DATABASE_URL=postgresql://user:password@localhost:5432/airlines_db

# --- Niveau de log (DEBUG, INFO, WARNING, ERROR) ---
LOG_LEVEL=INFO
