# =============================================================================
# FICHIER MODÈLE DES VARIABLES D'ENVIRONNEMENT
# -----------------------------------------------------------------------------
# Ce fichier est versionné dans Git (il ne contient AUCUN vrai secret).
# Il faut le copier en ".env" puis remplir les vraies valeurs :
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
# Le fichier ".env" réel, lui, est ignoré par Git (voir .gitignore).
# =============================================================================

# --- OpenSky Network (données de vols) ---
# Compte du site / récepteur ADS-B (feeder). Ce n'est PAS l'API Client :
# ne pas coller un Client ID (suffixe -api-client) ici, et ne pas s'en
# servir pour authentifier /flights/departure ou /flights/arrival.
OPENSKY_USERNAME=identifiant_opensky
OPENSKY_PASSWORD=mot_de_passe_opensky
#
# API Client OAuth2 — obligatoire pour l'API REST depuis mars 2026
# (Basic Auth identifiant/mot de passe n'est plus acceptée).
# Compte → https://opensky-network.org/my-opensky/account → carte « API Client ».
# Le Client ID (suffixe -api-client) s'affiche sur la page. Le secret
# n'y est PAS affiché : il est dans le fichier credentials.json
# téléchargé à la création. Coller toi-même (clés JSON camelCase) :
#   clientId     → OPENSKY_CLIENT_ID
#   clientSecret → OPENSKY_CLIENT_SECRET
# Si le fichier est perdu : bouton « Reset Credential » sur la même carte
# (nouveau JSON ; l'ancien secret est invalidé). Pas de flux device /
# mot de passe pour /flights. Doc :
#   https://openskynetwork.github.io/opensky-api/rest.html
#   https://github.com/openskynetwork/opensky-api
# Trino n'est PAS requis pour /flights. Feeder 8 000 crédits = optionnel
# (antenne ADS-B, ≥30 % uptime) ; Standard 4 000 suffit.
# Plan Standard : 4000 crédits / jour sur le seau /flights/* (plafond
# journalier, pas le restant). Le restant est dans l'en-tête HTTP
# X-Rate-Limit-Remaining. 10 hubs × 2 endpoints = 20 appels, chacun
# consomme des crédits : ne pas relancer une salve pour « tester ».
OPENSKY_CLIENT_ID=identifiant_client_opensky
OPENSKY_CLIENT_SECRET=secret_client_opensky

# --- OpenWeather (données météo) ---
# Clé API gratuite : https://openweathermap.org/api
OPENWEATHER_API_KEY=cle_api_openweather

# --- NewsAPI (actualités) ---
# Clé API gratuite : https://newsapi.org/
NEWSAPI_KEY=cle_api_newsapi

# --- Base de données ---
# Instance PostgreSQL locale (installation Windows, ou un conteneur isolé
# `docker run postgres:16`). Le docker-compose applicatif n'est pas requis ici.
DATABASE_URL=postgresql://user:password@localhost:5432/airlines_db

# --- Niveau de log (DEBUG, INFO, WARNING, ERROR) ---
LOG_LEVEL=INFO
